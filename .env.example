MERCURY_ENV=demo
MERCURY_DATABASE_URL=sqlite:///.data/mercury.db
MERCURY_AUTH_MODE=local
# Generate with: uv run python -m mercury.cli configure
MERCURY_JWT_SECRET=
MERCURY_DEMO_PASSWORD=
MERCURY_MODEL_MODE=deterministic_test
MERCURY_BUSINESS_MODE=synthetic
MERCURY_LLM_BASE_URL=https://api.openai.com/v1
MERCURY_LLM_MODEL=
MERCURY_LLM_API_KEY=
MERCURY_EMBEDDING_MODEL=
MERCURY_OIDC_ISSUER=
MERCURY_OIDC_AUDIENCE=
MERCURY_OIDC_JWKS_URL=
MERCURY_WEBHOOK_SECRET=
MERCURY_ALLOWED_ORIGINS=["http://localhost:3040","http://127.0.0.1:3040"]
MERCURY_WRITES_ENABLED=true
# OIDC browser login: fixed endpoints from your identity provider's official metadata.
MERCURY_OIDC_CLIENT_ID=
MERCURY_OIDC_CLIENT_SECRET=
MERCURY_OIDC_AUTHORIZATION_URL=
MERCURY_OIDC_TOKEN_URL=
MERCURY_OIDC_REDIRECT_URI=
# JSON array of Fernet keys. First encrypts; older keys only decrypt during rotation.
MERCURY_SESSION_ENCRYPTION_KEYS=[]
MERCURY_SESSION_HOURS=8
MERCURY_SESSION_IDLE_MINUTES=30
MERCURY_SCANNER_MODE=disabled
MERCURY_CLAMAV_HOST=clamav
MERCURY_CLAMAV_PORT=3310
MERCURY_WORKER_LEASE_SECONDS=120
MERCURY_RUN_TIMEOUT_SECONDS=600
MERCURY_WAITING_TIMEOUT_HOURS=48
# Set only after your organization approves data-class schedules and incident ownership.
MERCURY_PRIVACY_RETENTION_DAYS=0
MERCURY_AUDIT_RETENTION_DAYS=0
MERCURY_PRIVACY_POLICY_REF=
MERCURY_SECURITY_CONTACT=
# Quality benchmark size enforced by scripts/evaluate_quality.py.
MERCURY_MODEL_EVAL_MIN_CASES=30
